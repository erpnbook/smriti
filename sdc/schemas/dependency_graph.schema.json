{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DependencyGraph",
  "type": "OBJECT",
  "required": ["ir_version", "compiler_version", "artifact_type", "generated_at", "repository_commit", "provenance", "data"],
  "properties": {
    "ir_version": { "type": "STRING" },
    "compiler_version": { "type": "STRING" },
    "artifact_type": { "type": "STRING", "enum": ["dependency_graph"] },
    "generated_at": { "type": "STRING" },
    "repository_commit": { "type": "STRING" },
    "provenance": {
      "type": "OBJECT",
      "required": ["artifact_id", "produced_by", "consumes", "used_by"],
      "properties": {
        "artifact_id": { "type": "STRING" },
        "produced_by": { "type": "STRING" },
        "consumes": { "type": "ARRAY", "items": { "type": "STRING" } },
        "used_by": { "type": "ARRAY", "items": { "type": "STRING" } }
      }
    },
    "data": {
      "type": "OBJECT",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "ARRAY",
          "items": {
            "type": "OBJECT",
            "required": ["id", "type", "label"],
            "properties": {
              "id": { "type": "STRING" },
              "type": { "type": "STRING", "enum": ["FILE", "DOCTYPE", "FIELD", "API", "PRINT", "LAYOUT"] },
              "label": { "type": "STRING" }
            }
          }
        },
        "edges": {
          "type": "ARRAY",
          "items": {
            "type": "OBJECT",
            "required": ["source", "target", "relation"],
            "properties": {
              "source": { "type": "STRING" },
              "target": { "type": "STRING" },
              "relation": { "type": "STRING", "enum": ["USES", "DEPENDS_ON", "GENERATES", "EXTENDS", "IMPLEMENTS", "REFERENCES", "RENDERS", "VALIDATES"] }
            }
          }
        }
      }
    }
  }
}
