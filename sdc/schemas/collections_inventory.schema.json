{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CollectionsInventory",
  "type": "OBJECT",
  "required": ["ir_version", "compiler_version", "artifact_type", "generated_at", "repository_commit", "provenance", "data"],
  "properties": {
    "ir_version": { "type": "STRING" },
    "compiler_version": { "type": "STRING" },
    "artifact_type": { "type": "STRING", "enum": ["collections_inventory"] },
    "generated_at": { "type": "STRING" },
    "repository_commit": { "type": "STRING" },
    "provenance": {
      "type": "OBJECT",
      "required": ["artifact_id", "produced_by", "consumes", "used_by"],
      "properties": {
        "artifact_id": { "type": "STRING" },
        "produced_by": { "type": "STRING" },
        "consumes": { "type": "ARRAY", "items": { "type": "STRING" } },
        "used_by": { "type": "ARRAY", "items": { "type": "STRING" } }
      }
    },
    "data": {
      "type": "ARRAY",
      "items": {
        "type": "OBJECT",
        "required": ["collection_id", "title", "description", "assets"],
        "properties": {
          "collection_id": { "type": "STRING" },
          "title": { "type": "STRING" },
          "description": { "type": "STRING" },
          "assets": {
            "type": "ARRAY",
            "items": {
              "type": "OBJECT",
              "required": ["artifact_id", "asset_type", "title"],
              "properties": {
                "artifact_id": { "type": "STRING" },
                "asset_type": { "type": "STRING" },
                "title": { "type": "STRING" }
              }
            }
          }
        }
      }
    }
  }
}
