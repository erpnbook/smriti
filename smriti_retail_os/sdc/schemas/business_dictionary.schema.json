{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BusinessDictionary",
  "type": "OBJECT",
  "required": ["ir_version", "compiler_version", "artifact_type", "generated_at", "repository_commit", "provenance", "data"],
  "properties": {
    "ir_version": { "type": "STRING" },
    "compiler_version": { "type": "STRING" },
    "artifact_type": { "type": "STRING", "enum": ["business_dictionary"] },
    "generated_at": { "type": "STRING" },
    "repository_commit": { "type": "STRING" },
    "provenance": {
      "type": "OBJECT",
      "required": ["artifact_id", "produced_by", "consumes", "used_by"],
      "properties": {
        "artifact_id": { "type": "STRING" },
        "produced_by": { "type": "STRING" },
        "consumes": { "type": "ARRAY", "items": { "type": "STRING" } },
        "used_by": { "type": "ARRAY", "items": { "type": "STRING" } }
      }
    },
    "data": {
      "type": "ARRAY",
      "items": {
        "type": "OBJECT",
        "required": ["term_id", "term_name", "term_category", "definition", "hinglish_definition", "term_aliases"],
        "properties": {
          "term_id": { "type": "STRING" },
          "term_name": { "type": "STRING" },
          "term_category": { "type": "STRING" },
          "definition": { "type": "STRING" },
          "hinglish_definition": { "type": "STRING" },
          "term_aliases": { "type": "ARRAY", "items": { "type": "STRING" } },
          "manual_reference": { "type": "STRING" },
          "training_reference": { "type": "STRING" },
          "related_formulas": { "type": "ARRAY", "items": { "type": "STRING" } },
          "related_terms": { "type": "ARRAY", "items": { "type": "STRING" } },
          "faq": {
            "type": "ARRAY",
            "items": {
              "type": "OBJECT",
              "required": ["q", "a"],
              "properties": {
                "q": { "type": "STRING" },
                "a": { "type": "STRING" }
              }
            }
          },
          "common_mistakes": {
            "type": "ARRAY",
            "items": {
              "type": "OBJECT",
              "required": ["mistake", "a"],
              "properties": {
                "mistake": { "type": "STRING" },
                "a": { "type": "STRING" }
              }
            }
          }
        }
      }
    }
  }
}
